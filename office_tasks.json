   "options": {
    "rules": [
     {
      "type": "check_cell",
      "sheet_idx": "RNSheet2",
      "coordinate": "A1",
      "props": {
       "value": {
        "method": "eq",
        "ref": "Investment Summary"
       }
      }
     },
     {
      "type": "check_cell",
      "sheet_idx": "RNSheet2",
      "coordinate": "B1",
      "props": {
       "merge": {
