       "merge": {
        "method": "eq",
        "ref": false
       }
      }
     },
     {
      "type": "check_cell",
      "sheet_idx": "RNSheet2",
      "coordinate": "A2",
      "props": {
       "value": {
        "method": "eq",
        "ref": "High Interest Rate"
       }
      }
     },
     {
      "type": "check_cell",
      "sheet_idx": "RNSheet2",
